# Meta Model API key (dev.meta.ai -> API keys). Used by Muse Spark and Muse Voice Transcribe.
MODEL_API_KEY=

# Which provider each role uses: meta | baseten | openai_compat | mock
LLM_PROVIDER=meta
# AGENT_PROVIDER=meta
# VERIFIER_PROVIDER=baseten     # independent check on the open-weight model
# VISION_PROVIDER=meta

# Models (defaults shown)
# AGENT_MODEL=muse-spark-1.3
# VERIFIER_MODEL=meta-models/muse-spark-open-1026   (when VERIFIER_PROVIDER=baseten)
# REASONING_EFFORT=medium

# Muse Spark Open on Baseten (hackathon model id: meta-models/muse-spark-open-1026)
BASETEN_API_KEY=

# Any OpenAI-compatible server running Muse Spark Open / Muse Glimmer (vLLM, SGLang, Modal)
# OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPAT_MODEL=muse-glimmer
# OPENAI_COMPAT_API_KEY=

# Voice
# VOICE_MODEL=muse-voice-transcribe-1.0
# VOICE_LANGUAGES=English,Spanish

# MAX_AGENT_TURNS=18
# MAX_REVISIONS=1
